# Kopier til .env og lim inn nøkkelen. .env blir aldri med i git.
ANTHROPIC_API_KEY=

# Crewkoden fra lappen. Byen slipper ingen inn uten den.
CREW=

# Byen kjører på https://byen.hackaton.dev. Bytt bare hvis Syndikatet sier fra om en annen adresse.
# BYEN_URL=https://byen.hackaton.dev

# Oppdraget (kureren, flukt, berging, helikopter) og varianten. Argumentet til agenten vinner.
# OPPDRAG=kureren
# VARIANT=vanlig

# Et kort merke på kjøringen (høyst 40 tegn), så dere kjenner den igjen i byvisningen og på tavlen.
# MERKE=v1 uten guardrails

# Modellen og hvor hardt den tenker (low, medium, high, xhigh, max).
# MODELL=claude-sonnet-5-5
# EFFORT=medium
# MAX_ITERASJONER=50
